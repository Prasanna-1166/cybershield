# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to git.

# Flask
FLASK_APP=run.py
FLASK_CONFIG=development
SECRET_KEY=change-this-to-a-long-random-string
# Generate a strong one with: python -c "import secrets; print(secrets.token_hex(32))"

# Database
# Leave DATABASE_URL unset (or comment it out) to use the default local
# SQLite file at instance/cybershield.db — no server to install or run.
# DATABASE_URL=sqlite:///instance/cybershield.db
#
# To use PostgreSQL later (recommended for a real public deployment,
# since SQLite's file can be wiped on hosts with an ephemeral filesystem):
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<database>
#
# MySQL is also supported if you already run one:
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:3306/<database>

# Session / cookies
SESSION_COOKIE_SECURE=False
# Set SESSION_COOKIE_SECURE=True once you serve the app over HTTPS (required
# in production — FLASK_CONFIG=production sets this automatically).

# Rate limiting storage (in-memory is fine for a single-process demo; use a
# shared store like redis://... if you run multiple worker processes)
RATELIMIT_STORAGE_URI=memory://
